# NetIntel AI Suite - environment configuration

# API
API_HOST=0.0.0.0
API_PORT_ANOMALY=8001
API_PORT_CORRELATION=8002
API_PORT_OPTIMIZER=8003

# Paths
MODEL_PATH=./models
DATA_PATH=./data

# Monitoring
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Upstream integrations. Point these at your own SD-WAN controller and NOC
# webhook; the defaults below are placeholders and resolve to nothing.
SDWAN_CONTROLLER_URL=https://sdwan-controller.example.com/api
SDWAN_API_KEY=replace_me
NOC_WEBHOOK_URL=https://noc.example.com/webhooks/alerts
